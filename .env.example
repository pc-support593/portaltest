# このファイルを「.env」という名前でコピーして値を埋める(.env は git 管理外)
# Entra ID サインインを有効にする設定(docs/entra-setup.md §0 参照)
AUTH_MODE=entra
# アプリ登録の「概要」画面に表示される値(どちらも秘密情報ではない)
TENANT_ID=ここにテナントID(ディレクトリID)
CLIENT_ID=ここにクライアントID(アプリケーションID)
# 社内報(igrace.jp)の全社共通ログイン。ナビの「社内報」から自動ログインするために使う(値はサーバーの.envにだけ書く)
# IGRACE_USER=
# IGRACE_PASSWORD=
# 本番(サンプルデータを入れない)は false。未指定なら初回起動時にサンプルを投入する
# SEED_SAMPLE_DATA=false
# ポートを変える場合のみ
# PORT=3100
